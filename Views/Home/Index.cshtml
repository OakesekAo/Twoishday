                                            <label for="emailInput" class="form-label">Email</label>
                                            <input type="email" class="form-control" id="emailInput" placeholder="name@example.com" required>
                                        </div>
                                        <div class="mb-3">
                                            <label for="subjectInput" class="form-label">Subject</label>
                                            <input type="text" class="form-control" id="subjectInput" placeholder="How can we help?" required>
                                        </div>
                                        <div class="mb-3">
                                            <label for="messageInput" class="form-label">Message</label>
                                            <textarea class="form-control" id="messageInput" rows="5" placeholder="Tell us more about your needs..." required></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-primary w-100" disabled>
                                            <i class="bi bi-send me-2"></i>Send Message
                                        </button>
                                        <p class="text-muted small mt-2 mb-0">
