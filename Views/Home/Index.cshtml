                                <h3 class="card-title mb-3">Analytics & Reporting</h3>
                                <p class="card-text text-muted">
                                    Get real-time insights into your team's performance and progress, with customizable reporting and analytics tools.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
