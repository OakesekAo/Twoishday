@model IEnumerable<Twoishday.Models.Project>
@using Microsoft.AspNetCore.Identity
@using Twoishday.Models.Enums
@using Twoishday.Services.Interfaces

@inject UserManager<TDUser> UserManager
@inject ITDProjectService ProjectService

@{
    ViewData["Title"] = "Archived Projects";
    TDUser tdUser = await UserManager.GetUserAsync(User);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Archived Projects</h1>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table id="archivedProjectsTable" class="table table-hover w-100">
            <thead>
                <tr>
                    <th>Name</th>
                    <th class="d-none d-md-table-cell">Description</th>
                    <th class="d-none d-lg-table-cell">Start Date</th>
                    <th class="d-none d-lg-table-cell">End Date</th>
                    @if (User.IsInRole(nameof(Roles.Admin)))
                    {
                        <th class="d-none d-md-table-cell">Company</th>
                    }
                    <th>Priority</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    bool isProjectPM = (await ProjectService.GetProjectManagerAsync(item.Id))?.Id == tdUser.Id;
                    bool canEdit = User.IsInRole(nameof(Roles.Admin)) || isProjectPM;

                    <tr>
                        <td>
                            <strong>@item.Name</strong>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div class="d-md-none">
                                    <small class="text-muted">@item.Description.Substring(0, Math.Min(50, item.Description.Length))@(item.Description.Length > 50 ? "..." : "")</small>
                                </div>
                            }
                        </td>
                        <td class="d-none d-md-table-cell">@item.Description</td>
                        <td class="d-none d-lg-table-cell">@item.StartDate.ToString("MM/dd/yyyy")</td>
                        <td class="d-none d-lg-table-cell">@item.EndDate.ToString("MM/dd/yyyy")</td>
                        @if (User.IsInRole(nameof(Roles.Admin)))
                        {
                            <td class="d-none d-md-table-cell">@(item.Company?.Name ?? "N/A")</td>
                        }
                        <td>
                            @if (item.ProjectPriority != null)
                            {
                                var badgeClass = item.ProjectPriority.Name.ToLower() switch
                                {
                                    "urgent" => "badge bg-danger",
                                    "high" => "badge bg-warning text-dark",
                                    "medium" => "badge bg-info",
                                    "low" => "badge bg-secondary",
                                    _ => "badge bg-secondary"
                                };
                                <span class="@badgeClass">@item.ProjectPriority.Name</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">N/A</span>
                            }
                        </td>
                        <td>
                            <!-- Desktop Actions (≥768px) -->
                            <div class="d-none d-md-inline-flex gap-1">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" data-bs-toggle="tooltip" title="View Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (canEdit)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Edit Project">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Restore" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" data-bs-toggle="tooltip" title="Restore Project">
                                        <i class="fas fa-undo"></i>
                                    </a>
                                }
                            </div>

                            <!-- Mobile Actions (<768px) -->
                            <div class="d-md-none dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Project actions menu">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id"><i class="fas fa-eye me-2"></i>Details</a></li>
                                    @if (canEdit)
                                    {
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="fas fa-edit me-2"></i>Edit</a></li>
                                        <li><a class="dropdown-item" asp-action="Restore" asp-route-id="@item.Id"><i class="fas fa-undo me-2"></i>Restore</a></li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="empty-state text-center py-5">
        <i class="fas fa-archive fa-4x mb-3"></i>
        <h4>No Archived Projects</h4>
        <p class="text-muted">There are no archived projects at this time.</p>
        <a asp-action="AllProjects" class="btn btn-primary mt-3">
            <i class="fas fa-list me-2"></i>View Active Projects
        </a>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#archivedProjectsTable').DataTable({
                paging: false,
                info: false,
                ordering: true,
                searching: true,
                responsive: false,
                columnDefs: [
                    { orderable: false, targets: -1 }
                ]
            });

            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}
