@model IEnumerable<Twoishday.Models.Project>
@using Microsoft.AspNetCore.Identity;
@using Twoishday.Models.Enums
@using Twoishday.Services.Interfaces;

@inject UserManager<TDUser> UserManager
@inject ITDProjectService ProjectService

@{
    ViewData["Title"] = "My Projects";
    TDUser tdUser = await UserManager.GetUserAsync(User);
}

@* Page Header *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-user-folder me-2"></i>My Projects
        </h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">My Projects</li>
            </ol>
        </nav>
    </div>

    @if (User.IsInRole(nameof(Roles.Admin)) || User.IsInRole(nameof(Roles.ProjectManager)))
    {
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus-circle me-1"></i>Create New Project
            </a>
        </div>
    }
</div>

@* Projects Table Card *@
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-list me-1"></i>My Projects List
        </h6>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table id="myProjectsTable" class="table table-bordered table-hover projects-table w-100">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th class="d-none d-md-table-cell">Description</th>
                            <th>Priority</th>
                            <th class="d-none d-lg-table-cell">Progress</th>
                            <th class="d-none d-md-table-cell">Start Date</th>
                            <th class="d-none d-md-table-cell">End Date</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            @* Calculate progress *@
                            var totalTickets = item.Tickets?.Count ?? 0;
                            var completedTickets = item.Tickets?.Count(t => t.TicketStatus?.Name == "Resolved" || t.TicketStatus?.Name == "Closed") ?? 0;
                            var progressPercent = totalTickets > 0 ? (int)((completedTickets / (double)totalTickets) * 100) : 0;

                            <tr>
                                @* Project Name *@
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-decoration-none">
                                        @item.Name
                                    </a>
                                    @* Show ticket count badge *@
                                    <br />
                                    <small class="text-muted">
                                        <i class="fas fa-ticket-alt me-1"></i>@totalTickets ticket@(totalTickets != 1 ? "s" : "")
                                    </small>
                                </td>

                                @* Description (truncated) - Hidden on mobile *@
                                <td class="d-none d-md-table-cell">
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        @(item.Description.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)
                                    }
                                    else
                                    {
                                        <span class="text-muted">No description</span>
                                    }
                                </td>

                                @* Priority Badge *@
                                <td>
                                    @if (item.ProjectPriority != null)
                                    {
                                        var badgeClass = item.ProjectPriority.Name.ToLower() switch
                                        {
                                            "urgent" => "badge bg-danger",
                                            "high" => "badge bg-warning text-dark",
                                            "medium" => "badge bg-info",
                                            "low" => "badge bg-secondary",
                                            _ => "badge bg-secondary"
                                        };
                                        <span class="@badgeClass">
                                            @item.ProjectPriority.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">N/A</span>
                                    }
                                </td>

                                @* Progress Indicator - Hidden on small screens *@
                                <td class="d-none d-lg-table-cell">
                                    <div class="d-flex align-items-center">
                                        <div class="progress w-100 me-2" style="height: 20px;">
                                            <div class="progress-bar @(progressPercent >= 75 ? "bg-success" : progressPercent >= 50 ? "bg-info" : progressPercent >= 25 ? "bg-warning" : "bg-danger")" 
                                                 role="progressbar" 
                                                 style="width: @progressPercent%"
                                                 aria-valuenow="@progressPercent" 
                                                 aria-valuemin="0" 
                                                 aria-valuemax="100">
                                            </div>
                                        </div>
                                        <small class="text-nowrap">@progressPercent%</small>
                                    </div>
                                    <small class="text-muted">@completedTickets of @totalTickets completed</small>
                                </td>

                                @* Start Date - Hidden on mobile *@
                                <td class="d-none d-md-table-cell">
                                    @item.StartDate.ToString("MMM dd, yyyy")
                                </td>

                                @* End Date - Hidden on mobile *@
                                <td class="d-none d-md-table-cell">
                                    @item.EndDate.ToString("MMM dd, yyyy")
                                </td>

                                @* Status (sortable) *@
                                <td class="text-center" data-order="@(item.Archived ? "1" : "0")">
                                    @if (item.Archived)
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-archive me-1"></i>Archived
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-check-circle me-1"></i>Active
                                        </span>
                                    }
                                </td>

                                @* Actions - Responsive: Buttons on desktop, Dropdown on mobile *@
                                <td class="text-center">
                                    @{
                                        bool isProjectPM = (await ProjectService.GetProjectManagerAsync(item.Id))?.Id == tdUser.Id;
                                    }

                                    @* Desktop View - Icon Buttons *@
                                    <div class="d-none d-md-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" 
                                           class="btn btn-sm btn-info me-1" 
                                           data-bs-toggle="tooltip"
                                           data-bs-placement="top"
                                           title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        @if (User.IsInRole(nameof(Roles.Admin)) || isProjectPM)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-warning me-1" 
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="top"
                                               title="Edit Project">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            @if (item.Archived)
                                            {
                                                <a asp-action="Restore" asp-route-id="@item.Id" 
                                                   class="btn btn-sm btn-success" 
                                                   data-bs-toggle="tooltip"
                                                   data-bs-placement="top"
                                                   title="Restore Project">
                                                    <i class="fas fa-undo"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-action="Archive" asp-route-id="@item.Id" 
                                                   class="btn btn-sm btn-secondary" 
                                                   data-bs-toggle="tooltip"
                                                   data-bs-placement="top"
                                                   title="Archive Project"
                                                   onclick="return confirm('Are you sure you want to archive this project?');">
                                                    <i class="fas fa-archive"></i>
                                                </a>
                                            }
                                        }
                                    </div>

                                    @* Mobile/Tablet View - Dropdown Menu *@
                                    <div class="d-md-none dropdown">
                                        <button class="btn btn-sm btn-primary dropdown-toggle" type="button" 
                                                id="actionsDropdown@(item.Id)" 
                                                data-bs-toggle="dropdown" 
                                                aria-expanded="false"
                                                aria-label="Project actions menu">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="actionsDropdown@(item.Id)">
                                            <li>
                                                <a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id">
                                                    <i class="fas fa-eye me-2"></i>View Details
                                                </a>
                                            </li>

                                            @if (User.IsInRole(nameof(Roles.Admin)) || isProjectPM)
                                            {
                                                <li>
                                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">
                                                        <i class="fas fa-edit me-2"></i>Edit Project
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                @if (item.Archived)
                                                {
                                                    <li>
                                                        <a class="dropdown-item text-success" asp-action="Restore" asp-route-id="@item.Id">
                                                            <i class="fas fa-undo me-2"></i>Restore
                                                        </a>
                                                    </li>
                                                }
                                                else
                                                {
                                                    <li>
                                                        <a class="dropdown-item text-danger" asp-action="Archive" asp-route-id="@item.Id"
                                                           onclick="return confirm('Are you sure you want to archive this project?');">
                                                            <i class="fas fa-archive me-2"></i>Archive
                                                        </a>
                                                    </li>
                                                }
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            @* Empty State *@
            <div class="empty-state">
                <i class="fas fa-folder-open"></i>
                <p>You are not assigned to any projects</p>
                @if (User.IsInRole(nameof(Roles.Admin)) || User.IsInRole(nameof(Roles.ProjectManager)))
                {
                    <a asp-action="Create" class="btn btn-primary mt-2">
                        <i class="fas fa-plus me-1"></i>Create Your First Project
                    </a>
                }
            </div>
        }
    </div>
</div>

@section Styles {
    <link href="~/css/projects.css" rel="stylesheet" asp-append-version="true" />
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#myProjectsTable').DataTable({
                paging: false,
                info: false,
                ordering: true,
                searching: true,
                responsive: false,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search my projects..."
                },
                order: [[0, 'asc']],
                columnDefs: [
                    { orderable: false, targets: [7] }  // Actions column not sortable
                ]
            });

            // Initialize Bootstrap tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}
