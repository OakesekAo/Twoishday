                        <div class="step-number">2</div>
                        <h3 class="mb-3">Track Your Work</h3>
                        <p class="text-muted">Create tickets, assign tasks, set priorities, and monitor progress with powerful tracking tools.</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="how-it-works-step text-center p-4 p-md-5">
                        <div class="step-number">3</div>
                        <h3 class="mb-3">Deliver Results</h3>
                        <p class="text-muted">Collaborate in real-time, get insights with analytics, and ship projects faster than ever before.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Key Features Section -->
        <section class="bg-light py-5">
            <div class="container py-5">
                <h2 class="text-center mb-2 display-5 fw-bold">Powerful Features</h2>
                <p class="text-center text-muted mb-5">Everything you need to manage projects effectively</p>
