@model Twoishday.Models.ViewModels.DashboardViewModel
@using Microsoft.AspNetCore.Identity
@using Twoishday.Services.Interfaces

@inject UserManager<TDUser> UserManager
@inject ITDRolesService RolesService

@{
    ViewData["Title"] = "Dashboard";
    TDUser tdUser = await UserManager.GetUserAsync(User);
}

@section Styles {
    <link href="~/css/dashboard.css" rel="stylesheet" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">Dashboard</h1>
        <p class="text-muted mb-0">Welcome back, <strong>@tdUser.FullName</strong></p>
    </div>
    <div class="d-none d-md-block">
        <span class="text-muted small">
            <i class="fas fa-building"></i> @Model.Company.Name
        </span>
    </div>
</div>

@* KPI Cards Row *@
<div class="row g-3 mb-4">
    @* Total Projects *@
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
        <a asp-controller="Projects" asp-action="MyProjects" class="text-decoration-none">
            <div class="card kpi-card kpi-card-primary shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="kpi-value">@Model.TotalProjects</div>
                            <div class="kpi-label">My Projects</div>
                        </div>
                        <div class="kpi-icon">
                            <i class="fas fa-folder"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    @* Total Tickets *@
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
        <a asp-controller="Tickets" asp-action="MyTickets" class="text-decoration-none">
            <div class="card kpi-card kpi-card-success shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="kpi-value">@Model.TotalTickets</div>
                            <div class="kpi-label">My Tickets</div>
                        </div>
                        <div class="kpi-icon">
                            <i class="fas fa-ticket-alt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    @* Open Tickets *@
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
        <a asp-controller="Tickets" asp-action="MyTickets" class="text-decoration-none">
            <div class="card kpi-card kpi-card-info shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="kpi-value">@Model.OpenTickets</div>
                            <div class="kpi-label">Open Tickets</div>
                        </div>
                        <div class="kpi-icon">
                            <i class="fas fa-tasks"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    @* Closed Tickets *@
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
        <a asp-controller="Tickets" asp-action="MyTickets" class="text-decoration-none">
            <div class="card kpi-card kpi-card-secondary shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="kpi-value">@Model.ClosedTickets</div>
                            <div class="kpi-label">Closed Tickets</div>
                        </div>
                        <div class="kpi-icon">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    @* In Progress Tickets *@
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
        <a asp-controller="Tickets" asp-action="MyTickets" class="text-decoration-none">
            <div class="card kpi-card kpi-card-warning shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="kpi-value">@Model.InProgressTickets</div>
                            <div class="kpi-label">In Progress</div>
                        </div>
                        <div class="kpi-icon">
                            <i class="fas fa-tasks"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    @* Unassigned Tickets *@
    <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
        <a asp-controller="Tickets" asp-action="MyTickets" class="text-decoration-none">
            <div class="card kpi-card kpi-card-danger shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="kpi-value">@Model.UnassignedTickets</div>
                            <div class="kpi-label">Unassigned</div>
                        </div>
                        <div class="kpi-icon">
                            <i class="fas fa-user-slash"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

@* Charts Row *@
<div class="row g-3 mb-4">
    @* Tickets by Status Chart *@
    <div class="col-12 col-lg-6">
        <div class="card chart-card shadow">
            <div class="card-header">
                <i class="fas fa-chart-pie me-1"></i> Tickets by Status
            </div>
            <div class="card-body">
                @if (Model.TicketsByStatus != null && Model.TicketsByStatus.Any())
                {
                    <div class="chart-container">
                        <canvas id="ticketsByStatusChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-chart-pie"></i>
                        <p>No ticket data available</p>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Tickets by Priority Chart *@
    <div class="col-12 col-lg-6">
        <div class="card chart-card shadow">
            <div class="card-header">
                <i class="fas fa-chart-bar me-1"></i> Tickets by Priority
            </div>
            <div class="card-body">
                @if (Model.TicketsByPriority != null && Model.TicketsByPriority.Any())
                {
                    <div class="chart-container">
                        <canvas id="ticketsByPriorityChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-chart-bar"></i>
                        <p>No ticket data available</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Content Row *@
<div class="row g-3 mb-4">
    @* My Assigned Tickets *@
    <div class="col-12 col-lg-6">
        <div class="card chart-card shadow">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-user-check me-1"></i> My Assigned Tickets</span>
                <a asp-controller="Tickets" asp-action="MyTickets" class="btn btn-sm btn-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.MyAssignedTickets != null && Model.MyAssignedTickets.Any())
                {
                    <ul class="quick-ticket-list">
                        @foreach (var ticket in Model.MyAssignedTickets)
                        {
                            <li class="quick-ticket-item">
                                <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id" class="text-decoration-none">
                                    <div class="quick-ticket-title">@ticket.Title</div>
                                    <div class="quick-ticket-meta">
                                        <span class="badge badge-status-@ticket.TicketStatus.Name.ToLower().Replace(" ", "-")">
                                            @ticket.TicketStatus.Name
                                        </span>
                                        <span class="badge badge-priority-@ticket.TicketPriority.Name.ToLower()">
                                            @ticket.TicketPriority.Name
                                        </span>
                                        <span class="ms-2">
                                            <i class="far fa-clock"></i> @ticket.Created.ToString("MMM dd, yyyy")
                                        </span>
                                    </div>
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-inbox"></i>
                        <p>No tickets assigned to you</p>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Recent Activity *@
    <div class="col-12 col-lg-6">
        <div class="card chart-card shadow">
            <div class="card-header">
                <i class="fas fa-history me-1"></i> Recent Activity
            </div>
            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                @if (Model.RecentTickets != null && Model.RecentTickets.Any())
                {
                    <ul class="activity-feed">
                        @foreach (var ticket in Model.RecentTickets)
                        {
                            <li class="activity-feed-item status-@ticket.TicketStatus.Name.ToLower().Replace(" ", "-")">
                                <div class="activity-feed-content">
                                    <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.Id" class="text-decoration-none">
                                        <strong>@ticket.Title</strong>
                                    </a>
                                    <br />
                                    <small class="text-muted">
                                        @ticket.Project.Name
                                        @if (ticket.DeveloperUser != null)
                                        {
                                            <span> • Assigned to @ticket.DeveloperUser.FullName</span>
                                        }
                                    </small>
                                </div>
                                <div class="activity-feed-time">
                                    @((ticket.Updated ?? ticket.Created).ToString("MMM dd, yyyy h:mm tt"))
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-stream"></i>
                        <p>No recent activity</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Projects and Members Row *@
<div class="row g-3">
    @* Projects Table *@
    <div class="col-12 col-lg-8">
        <div class="card chart-card shadow">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-folder me-1"></i> Active Projects</span>
                <a asp-controller="Projects" asp-action="AllProjects" class="btn btn-sm btn-primary">View All</a>
            </div>
            <div class="card-body">
                @if (Model.Projects != null && Model.Projects.Any())
                {
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-hover">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Name</th>
                                    <th class="d-none d-md-table-cell">Start Date</th>
                                    <th class="d-none d-lg-table-cell">End Date</th>
                                    <th>Priority</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var project in Model.Projects.OrderByDescending(d => d.EndDate))
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id" class="text-decoration-none">
                                                <strong>@project.Name</strong>
                                            </a>
                                        </td>
                                        <td class="d-none d-md-table-cell">
                                            <small>@project.StartDate.ToString("MMM dd, yyyy")</small>
                                        </td>
                                        <td class="d-none d-lg-table-cell">
                                            <small>@project.EndDate.ToString("MMM dd, yyyy")</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-dark">@project.ProjectPriority?.Name</span>
                                        </td>
                                        <td>
                                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-folder-open"></i>
                        <p>No projects assigned to you</p>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Team Members *@
    <div class="col-12 col-lg-4">
        <div class="card chart-card shadow">
            <div class="card-header">
                <i class="fas fa-users me-1"></i> Team Members
            </div>
            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                @if (Model.Members != null && Model.Members.Any())
                {
                    @foreach (TDUser member in Model.Members)
                    {
                        <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                            <div class="me-3">
                                @if (member?.AvatarFileDate != null)
                                {
                                    <img class="rounded-circle" style="width:40px;height:40px;object-fit:cover;" src="data:image/*;base64,@(Convert.ToBase64String(member.AvatarFileDate))" alt="@member.FullName">
                                }
                                else
                                {
                                    <img class="rounded-circle" style="width:40px;height:40px;object-fit:cover;" src="https://cdn.icon-icons.com/icons2/1378/PNG/512/avatardefault_92824.png" alt="@member.FullName">
                                }
                            </div>
                            <div>
                                <div class="fw-bold">@member.FullName</div>
                                <small class="text-muted">@((await RolesService.GetUserRolesAsync(member)).FirstOrDefault())</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-users"></i>
                        <p>No team members found</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Tickets by Status Chart
        @if (Model.TicketsByStatus != null && Model.TicketsByStatus.Any())
        {
            <text>
            var statusCtx = document.getElementById('ticketsByStatusChart').getContext('2d');
            var statusChart = new Chart(statusCtx, {
                type: 'doughnut',
                data: {
                    labels: [@Html.Raw(string.Join(",", Model.TicketsByStatus.Keys.Select(k => $"'{k}'")))],
                    datasets: [{
                        data: [@Html.Raw(string.Join(",", Model.TicketsByStatus.Values))],
                        backgroundColor: [
                            '#1cc88a',
                            '#36b9cc',
                            '#858796',
                            '#5a5c69',
                            '#4e73df'
                        ],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                        }
                    }
                }
            });
            </text>
        }

        // Tickets by Priority Chart
        @if (Model.TicketsByPriority != null && Model.TicketsByPriority.Any())
        {
            <text>
            var priorityCtx = document.getElementById('ticketsByPriorityChart').getContext('2d');
            var priorityChart = new Chart(priorityCtx, {
                type: 'bar',
                data: {
                    labels: [@Html.Raw(string.Join(",", Model.TicketsByPriority.Keys.Select(k => $"'{k}'")))],
                    datasets: [{
                        label: 'Tickets',
                        data: [@Html.Raw(string.Join(",", Model.TicketsByPriority.Values))],
                        backgroundColor: [
                            '#e74a3b',
                            '#f6c23e',
                            '#36b9cc',
                            '#858796'
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1
                            }
                        }
                    }
                }
            });
            </text>
        }
    </script>
}
