        <!-- How It Works Section -->
        <section class="container py-5 my-5">
            <h2 class="text-center mb-2 display-5 fw-bold">How It Works</h2>
            <p class="text-center text-muted mb-5">Get started in minutes with our simple three-step process</p>
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="how-it-works-step text-center p-4 p-md-5">
                        <div class="step-number">1</div>
