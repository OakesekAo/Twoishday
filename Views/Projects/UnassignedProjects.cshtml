@model IEnumerable<Twoishday.Models.Project>
@using Microsoft.AspNetCore.Identity
@using Twoishday.Models.Enums

@inject UserManager<TDUser> UserManager

@{
    ViewData["Title"] = "Unassigned Projects";
    TDUser tdUser = await UserManager.GetUserAsync(User);
}

@* Page Header *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-user-slash me-2"></i>Unassigned Projects
        </h1>
        <p class="text-muted mb-0 small">Projects without a Project Manager assigned</p>
    </div>

    @if (User.IsInRole(nameof(Roles.Admin)) || User.IsInRole(nameof(Roles.ProjectManager)))
    {
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus-circle me-1"></i>Create New Project
            </a>
        </div>
    }
</div>

@* Projects Table Card *@
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-list me-1"></i>Projects Awaiting PM Assignment
        </h6>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="alert alert-warning" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Action Required:</strong> These projects need a Project Manager assigned to begin work.
            </div>

            <div class="table-responsive">
                <table id="unassignedProjectsTable" class="table table-bordered table-hover projects-table w-100">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th class="d-none d-md-table-cell">Description</th>
                            <th>Priority</th>
                            <th class="d-none d-md-table-cell">Start Date</th>
                            <th class="d-none d-md-table-cell">End Date</th>
                            @if (User.IsInRole(nameof(Roles.Admin)))
                            {
                                <th class="d-none d-md-table-cell">Company</th>
                            }
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                @* Project Name *@
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-decoration-none">
                                        @item.Name
                                    </a>
                                    <br />
                                    <small class="text-danger">
                                        <i class="fas fa-user-slash me-1"></i>No PM Assigned
                                    </small>
                                </td>

                                @* Description (truncated) - Hidden on mobile *@
                                <td class="d-none d-md-table-cell">
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        @(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                                    }
                                    else
                                    {
                                        <span class="text-muted">No description</span>
                                    }
                                </td>

                                @* Priority Badge *@
                                <td>
                                    @if (item.ProjectPriority != null)
                                    {
                                        var badgeClass = item.ProjectPriority.Name.ToLower() switch
                                        {
                                            "urgent" => "bg-danger",
                                            "high" => "bg-warning text-dark",
                                            "medium" => "bg-info",
                                            "low" => "bg-secondary",
                                            _ => "bg-secondary"
                                        };
                                        <span class="badge @badgeClass">
                                            @item.ProjectPriority.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">N/A</span>
                                    }
                                </td>

                                @* Start Date - Hidden on mobile *@
                                <td class="d-none d-md-table-cell">
                                    @item.StartDate.ToString("MMM dd, yyyy")
                                </td>

                                @* End Date - Hidden on mobile *@
                                <td class="d-none d-md-table-cell">
                                    @item.EndDate.ToString("MMM dd, yyyy")
                                </td>

                                @* Company - Admin only, Hidden on mobile *@
                                @if (User.IsInRole(nameof(Roles.Admin)))
                                {
                                    <td class="d-none d-md-table-cell">
                                        @(item.Company?.Name ?? "N/A")
                                    </td>
                                }

                                @* Actions - Responsive: Buttons on desktop, Dropdown on mobile *@
                                <td class="text-center">
                                    @* Desktop View - Icon Buttons *@
                                    <div class="d-none d-md-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" 
                                           class="btn btn-sm btn-info" 
                                           data-bs-toggle="tooltip"
                                           data-bs-placement="top"
                                           title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        @if (User.IsInRole(nameof(Roles.Admin)))
                                        {
                                            <a asp-action="AssignPM" asp-route-projectId="@item.Id" 
                                               class="btn btn-sm btn-primary" 
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="top"
                                               title="Assign Project Manager">
                                                <i class="fas fa-user-plus"></i>
                                            </a>

                                            <a asp-action="Edit" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-warning" 
                                               data-bs-toggle="tooltip"
                                               data-bs-placement="top"
                                               title="Edit Project">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        }
                                    </div>

                                    @* Mobile/Tablet View - Dropdown Menu *@
                                    <div class="d-md-none dropdown">
                                        <button class="btn btn-sm btn-primary dropdown-toggle" type="button" 
                                                id="actionsDropdown@(item.Id)" 
                                                data-bs-toggle="dropdown" 
                                                aria-expanded="false"
                                                aria-label="Project actions menu">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="actionsDropdown@(item.Id)">
                                            <li>
                                                <a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id">
                                                    <i class="fas fa-eye me-2"></i>View Details
                                                </a>
                                            </li>

                                            @if (User.IsInRole(nameof(Roles.Admin)))
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item text-primary" asp-action="AssignPM" asp-route-projectId="@item.Id">
                                                        <i class="fas fa-user-plus me-2"></i>Assign PM
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">
                                                        <i class="fas fa-edit me-2"></i>Edit Project
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            @* Empty State *@
            <div class="empty-state">
                <i class="fas fa-check-circle"></i>
                <p>All projects have Project Managers assigned!</p>
                <p class="text-muted small">Great work! Every project has a PM to lead the team.</p>
                @if (User.IsInRole(nameof(Roles.Admin)) || User.IsInRole(nameof(Roles.ProjectManager)))
                {
                    <a asp-action="AllProjects" class="btn btn-primary mt-2">
                        <i class="fas fa-list me-1"></i>View All Projects
                    </a>
                }
            </div>
        }
    </div>
</div>

@section Styles {
    <link href="~/css/projects.css" rel="stylesheet" asp-append-version="true" />
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Determine if Admin (Company column present)
            var isAdmin = @(User.IsInRole(nameof(Roles.Admin)) ? "true" : "false");
            var actionsColumnIndex = isAdmin ? 6 : 5;  // Actions column shifts if Company column present

            $('#unassignedProjectsTable').DataTable({
                paging: false,        // No pagination (MVP requirement)
                info: false,          // Hide "Showing 1 to X of Y entries"
                ordering: true,       // Enable column sorting
                searching: true,      // Enable search box
                responsive: false,    // Disable DataTables responsive (using CSS instead)
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search unassigned projects..."
                },
                // Default sort by Priority (column 2) descending to show urgent first
                order: [[2, 'desc']],
                // Disable sorting on Actions column only
                columnDefs: [
                    { orderable: false, targets: [actionsColumnIndex] }
                ]
            });

            // Initialize Bootstrap tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}
